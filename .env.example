DATABASE_URL=postgres://app:app@localhost:5432/app
# Used by docker-compose.prod.yml (deploy only)
POSTGRES_PASSWORD=app

# AI: openrouter | openai-compatible
AI_PROVIDER=openrouter
# Model id for the chosen provider (openrouter uses e.g. openrouter/free)
AI_MODEL=openrouter/free
# Embedding model id (only if you use vector search)
AI_EMBEDDING_MODEL=
# Only for openai-compatible (with AI_API_KEY)
AI_BASE_URL=
OPENROUTER_API_KEY=
AI_API_KEY=
